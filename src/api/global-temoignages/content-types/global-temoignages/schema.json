{
  "kind": "singleType",
  "collectionName": "global_temoignages",
  "info": {
    "singularName": "global-temoignages",
    "pluralName": "global-temoignages-collection",
    "displayName": "Témoignages globaux",
    "description": "Données partagées du carousel d'avis sur tout le site"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "string"
    },
    "cta_texte": {
      "type": "string"
    },
    "cta_lien": {
      "type": "string"
    },
    "cta_couleur": {
      "type": "customField",
      "regex": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
      "customField": "plugin::color-picker.color"
    },
    "entries": {
      "type": "component",
      "repeatable": true,
      "component": "blocks.testimonial-entry"
    }
  }
}
