{
  "kind": "collectionType",
  "collectionName": "landings",
  "info": {
    "singularName": "landing",
    "pluralName": "landings",
    "displayName": "Landing",
    "description": "Landing pages locales (1 entrée = 1 ville / mode)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "titre": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "titre",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "localite": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "mode": {
      "type": "enumeration",
      "enum": ["cabinet", "visio", "hybride"],
      "default": "hybride",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "zones_desservies": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "h1": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "Metadatas": {
      "type": "component",
      "repeatable": false,
      "component": "seo.seo-metadatas",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "couleur_page": {
      "type": "customField",
      "regex": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
      "customField": "plugin::color-picker.color"
    },
    "faq": {
      "type": "component",
      "repeatable": true,
      "component": "landing.faq-item",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "landing.hero",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "features": {
      "type": "component",
      "repeatable": false,
      "component": "landing.features-grid",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "section_1": {
      "type": "component",
      "repeatable": false,
      "component": "landing.img-texte",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "section_2": {
      "type": "component",
      "repeatable": false,
      "component": "landing.img-texte",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "temoignages": {
      "type": "component",
      "repeatable": false,
      "component": "landing.temoignages",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "dual_cta": {
      "type": "component",
      "repeatable": false,
      "component": "landing.dual-cta",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "stats_bar": {
      "type": "component",
      "repeatable": false,
      "component": "landing.stats-bar",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "cta_final": {
      "type": "component",
      "repeatable": false,
      "component": "basic.wide-bloc-cta",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "pages_liees": {
      "type": "component",
      "repeatable": true,
      "component": "basic.bouton",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
