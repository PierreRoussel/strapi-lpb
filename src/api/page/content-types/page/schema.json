{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Pages éditables via le page-builder visuel"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titre",
      "required": true
    },
    "metadatas": {
      "type": "component",
      "repeatable": false,
      "component": "seo.seo-metadatas"
    },
    "couleur_page": {
      "type": "customField",
      "regex": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
      "customField": "plugin::color-picker.color"
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "blocks.hero",
        "blocks.rich-text",
        "blocks.section-title",
        "blocks.faq",
        "blocks.temoignages",
        "blocks.prestations-grid",
        "blocks.articles-preview",
        "blocks.contact-form",
        "blocks.horizontal-cards",
        "blocks.atelier-cta",
        "blocks.partners",
        "blocks.page-header",
        "blocks.landing-intro",
        "blocks.promote-blog",
        "blocks.google-review",
        "basic.img-display",
        "basic.bloc-cta",
        "basic.wide-bloc-cta",
        "basic.lieux"
      ]
    }
  }
}
